# ==========================================
# Smart Task Manager — Environment Variables
# ==========================================

# Django Core
SECRET_KEY=django-insecure-replace-with-a-secure-random-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web,testserver
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database Configuration
# In Docker: postgres://taskuser:taskpassword@db:5432/taskdb
# For SQLite local dev: leave empty
DATABASE_URL=postgres://taskuser:taskpassword@db:5432/taskdb

# Celery & Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# Email Configuration
# Default is console backend (prints emails to terminal/logs)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Smart Task Manager <noreply@smarttaskmanager.local>
# For production SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-api-key
# EMAIL_USE_TLS=True

# Structured Logging
DJANGO_LOG_LEVEL=INFO
